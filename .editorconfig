root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,json,ts,tsx,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,rs,toml}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{py,sql}]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
